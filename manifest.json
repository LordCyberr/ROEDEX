{
  "manifest_version": 3,
  "name": "ROEDEX",
  "version": "0.0.5",
  "description": "ROEDEX — The ultimate real-time overlay for Roots of Embervault. Live HUDs, interactive minimap, marketplace analytics, loot tracker, spawn timers & 4-language support.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": "icon128.png",
    "default_title": "ROEDEX Overlay"
  },
  "content_scripts": [
    {
      "js": [
        "src/main.tsx"
      ],
      "matches": [
        "*://embervault.ruyui.com/*"
      ]
    },
    {
      "js": [
        "src/core/websocket/interceptor.ts"
      ],
      "matches": [
        "*://embervault.ruyui.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.webp",
        "assets/*",
        "defaultTrails.json",
        "maps.json",
        "staticSpawns.json"
      ],
      "matches": [
        "*://embervault.ruyui.com/*"
      ]
    }
  ]
}